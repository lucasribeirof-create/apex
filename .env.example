# APEX Manager - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Anthropic API Key - obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=sua_chave_aqui

# BRAPI Token - obtenha em https://brapi.dev (plano gratuito disponivel)
BRAPI_TOKEN=seu_token_aqui

# Modelo Claude
CLAUDE_MODEL=claude-sonnet-4-5

# Banco de dados (padrao: SQLite local - nao precisa alterar nesta fase)
# Migracao futura: DATABASE_URL=postgresql://user:senha@localhost:5432/apex
DATABASE_URL=

# Servidor
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Morning Briefing - horario de geracao automatica (24h)
BRIEFING_HOUR=8
BRIEFING_MINUTE=45
